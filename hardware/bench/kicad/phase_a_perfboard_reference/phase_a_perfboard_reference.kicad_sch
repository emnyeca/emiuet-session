	(label "LCD_BLK" (at 185.42 177.8 0) (effects (font (size 1.27 1.27)) (justify right)) (uuid "126df6eb-98a3-4100-b7c2-8c4b820f423c"))
	(text "Emiuet Session Bench - Phase A hand-wiring reference (NOT a production PCB)" (at 110.0 18.0 0) (effects (font (size 2.2 2.2)) (justify left)) (uuid "56417199-723f-4235-bb74-fe0c1ef6b93d"))
	(text "Scan: columns INPUT_PULLUP, rows driven LOW one at a time; pressed key reads LOW on its column." (at 110.0 28.0 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "182db50a-8872-4b11-bcc4-e4c5918441d1"))
	(text "Diode orientation: ANODE -> COLUMN, CATHODE -> ROW.  *** CONFIRM diode orientation before soldering the 16-key board ***" (at 110.0 34.0 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "6f0566d6-394b-421a-8695-cd917818a27b"))
	(text "All logic 3.3V. Teensy 4.1 GPIO is NOT 5V tolerant. Do NOT connect 5V to Teensy GPIO. Verify OLED/LCD module VCC = 3.3V." (at 110.0 40.0 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "287d59c7-1adf-41ef-83f1-9aa57599c225"))
	(text "Pins 0/1 (Serial1 RX1/TX1) reserved for Phase B TRS MIDI. No MIDI jack/optocoupler/transistor/circuit in this schematic." (at 110.0 46.0 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "1e9079e3-09d4-4f9c-8216-c396c601fdd5"))
	(text "Display options: I2C OLED and SPI LCD are alternatives - populate only one. Connector pin order varies by module: verify." (at 110.0 52.0 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "0e78168a-24f9-4ea8-b5aa-8c895bc54c16"))
	(text "Key matrix: rows = Teensy 24-27, columns = Teensy 28-31. Nets KEY_ROW0..3 / KEY_COL0..3." (at 110.0 142.0 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "1720f288-310e-4c39-93c2-0ae9b2a058d8"))
	(text "Encoder: A=36 B=37 PUSH=38.  I2C OLED: SDA=18 SCL=19.  SPI LCD: SCK=13 MOSI=11 CS=10 RES=32 DC=33 BLK=34." (at 110.0 148.0 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "6f79ba6f-ac3e-4d2d-b0bf-f869f2721bbe"))
