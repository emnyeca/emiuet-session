# Generic interfaces and 2-terminal parts for the Emiuet Session bench.
#
# These are intentionally generic (no footprints / part numbers) so the scaffold
# stays robust across atopile versions and is easy to repair. They describe wiring
# intent only.

# --- Named interfaces -------------------------------------------------------

interface Power:
    # 3.3 V logic supply rail for the bench. Teensy 4.1 is 3.3 V only.
    signal vcc
    signal gnd

interface I2C:
    signal sda
    signal scl

interface SPI:
    signal sck
    signal mosi
    signal cs

interface UART:
    # Reserved for Phase B TRS MIDI (Serial1). Not wired in Phase A.
    signal tx
    signal rx

# --- Generic 2-terminal parts ----------------------------------------------

module Switch:
    # A momentary key switch (Phase A: tact switch; later: replaceable input).
    signal p1
    signal p2

module Diode:
    # Per-key anti-ghosting diode (e.g. 1N4148). Orientation: anode -> cathode.
    signal anode
    signal cathode
